{
  "expo": {
    "name": "Cinelink",
    "slug": "cinelink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cinelinkIcon.png",
    "scheme": "leafyapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "UIViewControllerBasedStatusBarAppearance": true,
      "UIStatusBarHidden": true,
      "UIRequiresFullScreen": true,
      "bundleIdentifier": "com.cinelink.app",
      "edgeToEdgeEnabled": true
    },
    "android": {
      "package": "com.cinelink.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cinelinkIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8319bbc8-e0d3-462c-ab14-a3e3e3879451"
      }
    },
    "owner": "tarashunchakorg"
  }
}