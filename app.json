{
  "expo": {
    "name": "Cinelink",
    "slug": "cinelink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "scheme": "leafyapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "UIViewControllerBasedStatusBarAppearance": true,
      "UIStatusBarHidden": true,
      "UIRequiresFullScreen": true,
      "bundleIdentifier": "com.cinelink.app",
      "edgeToEdgeEnabled": true,
      "foregroundImage": "./assets/images/cinelinkIcon.png"
    },
    "android": {
      "package": "com.cinelink.app",
      "ndkVersion": "27.1.12297006",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cinelinkIconNew.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cinelinkIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8319bbc8-e0d3-462c-ab14-a3e3e3879451"
      }
    },
    "owner": "tarashunchakorg"
  }
}